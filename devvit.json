{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pakia-pakia",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Pakia Pakia!: post today's bag",
        "description": "Create a new post with today's receipt",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Pakia Pakia!: review community receipts",
        "description": "Remove pending receipts before they are voted in",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/review-receipts"
      }
    ]
  },
  "forms": {
    "removeReceiptForm": "/internal/form/remove-receipt"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
